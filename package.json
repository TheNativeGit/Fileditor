{
  "name": "fileditor",
  "private": true,
  "version": "1.0.1",
  "license": "MIT",
  "homepage": "https://nativeproduction.de",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "tauri": "tauri",
    "test:rust": "node scripts/test_rust.cjs",
    "build:tauri": "node scripts/build_tauri.cjs",
    "copy:logo": "node scripts/copy_logo.cjs",
    "build:icon": "tauri icon src-tauri/icons/icon.png",
    "copy:installer": "node scripts/ship.cjs --installer",
    "copy:standalone": "node scripts/ship.cjs --standalone",
    "copy:windows": "node scripts/ship.cjs --windows",
    "ship:installer": "npm run build:tauri && npm run copy:installer",
    "ship:standalone": "npm run build:tauri && npm run copy:standalone",
    "ship:windows": "npm run build:tauri && npm run copy:windows",
    "ship:all": "npm run ship:windows",
    "setup:dev": "node scripts/setup_dev.cjs",
    "generate:nsis": "node scripts/generate_nsis_images.cjs",
    "bump": "node scripts/bump_version.cjs",
    "release:public": "node scripts/release_public.cjs"
  },
  "dependencies": {
    "@ant-design/icons": "^5.3.7",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/plus-jakarta-sans": "^5.3.0",
    "@monaco-editor/react": "^4.6.0",
    "@tauri-apps/api": "^2.12.5",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.1",
    "ajv": "^8.16.0",
    "antd": "^5.18.0",
    "dompurify": "^3.5.0",
    "lucide-react": "^0.395.0",
    "monaco-editor": "^0.52.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.2",
    "@types/dompurify": "^3.0.5",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.2.2",
    "vite": "^5.3.1"
  }
